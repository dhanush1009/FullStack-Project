pipeline {
    agent any

    environment {
        // Disabled Docker Hub push for now to avoid the credentials crash!
        // DOCKER_CREDS = credentials('docker-hub-credentials')
        // DOCKER_USERNAME = "${DOCKER_CREDS_USR}"
        // DOCKER_PASSWORD = "${DOCKER_CREDS_PSW}"
        
        BACKEND_IMAGE = "pronto-backend:${env.BUILD_ID}"
        FRONTEND_IMAGE = "pronto-frontend:${env.BUILD_ID}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Build Docker Images') {
            steps {
                echo 'Building Backend Image...'
                dir('pronto-response-main/backend') {
                    sh "docker build -t ${BACKEND_IMAGE} ."
                }

                echo 'Building Frontend Image...'
                dir('pronto-response-main/frontend') {
                    sh "docker build -t ${FRONTEND_IMAGE} ."
                }
            }
        }

        // stage('Push Docker Images') {
        //     steps {
        //         echo 'Logging into Docker Hub...'
        //         sh "echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME --password-stdin"
        //         sh "docker push ${BACKEND_IMAGE} ."
        //         sh "docker push ${FRONTEND_IMAGE} ."
        //     }
        // }

        stage('Deploy locally using Docker Compose') {
            steps {
                dir('pronto-response-main') {
                    echo 'Starting services...'
                    sh 'docker-compose down' // Remove old containers
                    sh 'docker-compose up -d'
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up Docker images...'
            sh "docker rmi ${BACKEND_IMAGE} || true"
            sh "docker rmi ${FRONTEND_IMAGE} || true"
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed! Please check logs.'
        }
    }
}
